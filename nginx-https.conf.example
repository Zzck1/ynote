# Replace every ynote.example.com and provision its real TLS certificate first.
server {
    listen 80;
    server_name ynote.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ynote.example.com;
    ssl_certificate /etc/letsencrypt/live/ynote.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ynote.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    client_body_timeout 180s;

    # No public management page or administrator API.
    location ^~ /admin/ { return 404; }
    location ^~ /api/admin/ { return 404; }

    location = /api/relay/transcribe {
        client_max_body_size 51m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 240s;
        proxy_send_timeout 240s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Range "";
        proxy_set_header If-Range "";
        proxy_pass http://127.0.0.1:8792;
    }

    location / {
        proxy_buffering off;
        proxy_read_timeout 240s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Public cloud endpoints serve no seekable user media. Strip Range to
        # avoid old Starlette multipart-range parsing; local helper keeps Range.
        proxy_set_header Range "";
        proxy_set_header If-Range "";
        proxy_pass http://127.0.0.1:8792;
    }
}
